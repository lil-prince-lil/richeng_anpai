# 复制为 .env 并填入真实值
PORT=3000

# apimart（OpenAI 兼容网关）
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=在此填入你的_apimart_key

# 模型名
CHAT_MODEL=deepseek-v4-pro
ASR_MODEL=whisper-1

# 单用户鉴权口令（前端与此保持一致，自定义一个长随机串）
APP_TOKEN=换成一个自定义的长随机口令

# 数据库文件
DB_PATH=./data/schedule.db

# 默认时区
DEFAULT_TZ=Asia/Shanghai
